# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://hvac_user:hvac_password@localhost:5432/hvac_diagnostic
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hvac_diagnostic
DB_USER=hvac_user
DB_PASSWORD=hvac_password

# Redis Configuration
REDIS_URL=redis://:hvac_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=hvac_redis_password
REDIS_DB=0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-too
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
PASSWORD_SALT_ROUNDS=12

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=HVAC AI Diagnostic
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=HVAC AI Diagnostic
VITE_ENVIRONMENT=development
VITE_API_TIMEOUT=30000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@hvac-diagnostic.com
EMAILS_FROM_NAME=HVAC AI Diagnostic

# AI/ML Configuration
ML_MODEL_PATH=/app/data/models
OPENAI_API_KEY=your-openai-api-key-if-using
HUGGINGFACE_API_KEY=your-huggingface-api-key-if-using

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=hvac-diagnostic-files

# File Storage (Azure Blob - Alternative)
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_CONTAINER_NAME=hvac-files

# Monitoring & Logging
SENTRY_DSN=your-sentry-dsn-for-error-tracking
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Celery Configuration
CELERY_BROKER_URL=redis://:hvac_redis_password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:hvac_redis_password@localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# External APIs
WEATHER_API_KEY=your-weather-api-key
EQUIPMENT_DATABASE_API_KEY=your-equipment-db-api-key

# Feature Flags
ENABLE_AI_DIAGNOSTICS=true
ENABLE_PREDICTIVE_MAINTENANCE=true
ENABLE_REAL_TIME_MONITORING=true
ENABLE_MOBILE_NOTIFICATIONS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Session Configuration
SESSION_TIMEOUT_MINUTES=480
REMEMBER_ME_DAYS=30

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=["jpg","jpeg","png","pdf","docx","xlsx"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Timezone
DEFAULT_TIMEZONE=UTC

# Development Tools
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_PROMETHEUS_METRICS=true

# Testing
TEST_DATABASE_URL=postgresql://hvac_user:hvac_password@localhost:5432/hvac_diagnostic_test
TEST_REDIS_URL=redis://:hvac_redis_password@localhost:6379/1